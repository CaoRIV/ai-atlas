# PostgreSQL local development
POSTGRES_DB=ai_atlas
POSTGRES_USER=ai_atlas
POSTGRES_PASSWORD=ai_atlas_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ai_atlas:ai_atlas_dev@127.0.0.1:5432/ai_atlas

# Server-only FastAPI origin used by the Next.js Catalog BFF
API_BASE_URL=http://127.0.0.1:8000
CATALOG_API_TIMEOUT_MS=10000

# Auth0 OIDC placeholders (TASK-016 implements the flow)
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SESSION_SECRET=

# Gemini Developer API
LLM_PROVIDER=google_gemini
LLM_MODEL=gemini-3.5-flash-lite
EMBEDDING_PROVIDER=google_gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=1536
GEMINI_API_KEY=
GEMINI_REQUEST_TIMEOUT_MS=20000
GEMINI_MAX_OUTPUT_TOKENS=2048
RUN_LIVE_AI_TESTS=0

# Runtime budget guard is implemented in TASK-015. Empty is not unlimited.
AI_MONTHLY_BUDGET_USD=

