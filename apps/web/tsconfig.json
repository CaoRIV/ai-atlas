{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".cache/next-task0061-smoke-5cd6581e-4ca3-4d9e-be19-26a6cd8f2d02/types/**/*.ts",
    ".cache/next-task0061-smoke-5cd6581e-4ca3-4d9e-be19-26a6cd8f2d02/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
